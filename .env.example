# ── Switchboard Slack service — environment ────────────────────────────────
# Copy to `.env` and fill in real values. `.env` is gitignored. Never commit secrets.

# ── Slack ───────────────────────────────────────────────────────────────────
# Bot token (xoxb-…) from your internal Slack app's "OAuth & Permissions".
SLACK_BOT_TOKEN=xoxb-your-bot-token
# Signing secret from "Basic Information" → App Credentials. Bolt uses it to verify requests.
SLACK_SIGNING_SECRET=your-signing-secret
# App-level token (xapp-…) — ONLY needed when SWITCHBOARD_SOCKET_MODE=true.
SLACK_APP_TOKEN=xapp-your-app-token
# true  → Socket Mode: fastest local demo, no public URL / tunnel / signing needed.
# false → HTTP mode: Slack POSTs to https://<host>/slack/events (needs a tunnel locally).
SWITCHBOARD_SOCKET_MODE=false
# The slash command to register the handler under (leading slash required).
SLACK_COMMAND=/switchboard
# HTTP port (HTTP mode only).
PORT=3000

# ── LLM gateway (OpenAI-compatible) ──────────────────────────────────────────
# Shopify internal OpenAI-compatible gateway base URL (should end in /v1 or equivalent).
LLM_BASE_URL=https://your-internal-openai-gateway/v1
# Server token for the gateway.
LLM_API_KEY=your-llm-gateway-token
# Same model the web app uses.
LLM_MODEL=gpt-5.4
# Per-call timeout (ms) so a hung gateway can't stall the request.
LLM_TIMEOUT_MS=20000

# ── BigQuery ─────────────────────────────────────────────────────────────────
# Path to the service-account JSON key with read on the shopify-dw datasets used by the
# queries (people.slack_*, base.base__infra_central__*, base.base__github__default_branch_commits,
# infrastructure.github_users). If unset, Application Default Credentials are used.
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
# Billing/execution project for the query jobs (NOT the table project, which is shopify-dw).
BIGQUERY_PROJECT_ID=your-execution-project
# Dataset location for jobs.
BIGQUERY_LOCATION=US
# Hard per-job byte cap so a runaway query fails fast instead of draining quota (~50 GB default).
BIGQUERY_MAX_BYTES_BILLED=50000000000

# ── Shared knowledge store (overrides / feedback / recent) ───────────────────
# file  → local JSON/JSONL store (default, no external auth).
# quick → Quick site REST API (stub; IAP service-auth unresolved).
STORE_BACKEND=file
# Directory for the file store (created on first write).
STORE_FILE_PATH=./data
# Base URL for the Quick REST API backend (only used when STORE_BACKEND=quick).
QUICK_API_BASE_URL=https://switchboard-hq.quick.shopify.io/api/db

# ── Misc ─────────────────────────────────────────────────────────────────────
# How long the in-memory cache of overrides+votes is trusted before refresh (ms).
SHARED_CACHE_TTL_MS=60000
LOG_LEVEL=info
