{
  "name": "switchboard",
  "version": "0.1.0",
  "private": true,
  "description": "Switchboard as a Slack slash command — who owns this, where do I ask? Ported from the Quick web app.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "route": "tsx scripts/route.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@google-cloud/bigquery": "^7.9.0",
    "@slack/bolt": "^3.22.0",
    "dotenv": "^16.4.5",
    "openai": "^4.67.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.16.11",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.3"
  }
}
